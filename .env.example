# The SPA talks to the API same-origin: in dev Vite proxies /api and /socket.io to the API
# (see vite.config.ts); in production a reverse proxy does the same. Override only when needed.

# API base path or absolute URL (default: /api/v1)
# VITE_API_BASE_URL=/api/v1

# Socket.IO origin (default: same origin) and path (default: /socket.io)
# VITE_REALTIME_URL=
# VITE_REALTIME_PATH=/socket.io

# Dev-server proxy target (read by vite.config.ts, not exposed to the browser)
# DEV_API_TARGET=http://127.0.0.1:3890
