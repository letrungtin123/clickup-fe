{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "composite": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "strict": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "tsBuildInfoFile": "dist/.tsbuild/node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
